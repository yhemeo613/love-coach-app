# ============================================================
#  恋爱教练 · 生产环境变量模板
#  复制为 .env 后逐项填写；.env 已被 .gitignore 忽略
# ============================================================

# ---------- 大模型（OpenAI 兼容：DeepSeek 官方）----------
# 可用模型：deepseek-flash（快） / deepseek-v4-pro（强）
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-在这里填你的-deepseek-key
LLM_MODEL=deepseek-flash
# FIM 补全（Beta）必须使用 /beta 前缀
LLM_FIM_BASE=https://api.deepseek.com/beta
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1600
CHAT_HISTORY_LIMIT=16

# ---------- 站点 ----------
NEXT_PUBLIC_SITE_NAME=恋爱教练
# 对外访问地址（OAuth 回调与 cookie 依赖它，必须与浏览器实际访问地址一致）
# 例：http://1.2.3.4:3000 或 https://your-domain.com
BETTER_AUTH_URL=http://127.0.0.1:3000
# 会话签名密钥：openssl rand -hex 32 生成，必须保密
BETTER_AUTH_SECRET=请替换为随机字符串

# ---------- PostgreSQL ----------
POSTGRES_USER=lovecoach
POSTGRES_PASSWORD=请替换为强密码
POSTGRES_DB=lovecoach
# 本机开发时指向本地端口；compose 会自动覆盖为 postgres 服务名
DATABASE_URL=postgresql://lovecoach:请替换为强密码@127.0.0.1:5432/lovecoach?schema=public
DATABASE_POOL_MAX=10

# ---------- Redis ----------
REDIS_URL=redis://127.0.0.1:6379

# ---------- 登录方式 ----------
# 管理员邮箱白名单（逗号分隔），命中即拥有后台权限
ADMIN_EMAILS=you@example.com
# 邮箱密码登录：生产保持 0；本地联调可设 1
ALLOW_PASSWORD_LOGIN=0
NEXT_PUBLIC_ALLOW_PASSWORD_LOGIN=0

# GitHub OAuth：https://github.com/settings/developers
# 回调地址：{BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth：https://console.cloud.google.com/apis/credentials
# 注意：Google 要求回调地址必须是 HTTPS（localhost 除外）
# 回调地址：{BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- 限流与配额 ----------
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_PER_DAY=200

# ---------- 部署 ----------
# 应用对外端口（compose 使用）
APP_PORT=3000
